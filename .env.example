# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Pinned model snapshot for reproducible evaluations (default: gpt-4o)
OPENAI_MODEL=gpt-4o-2024-08-06

# Per-analysis token budget ceiling (halts run gracefully if exceeded)
ANALYSIS_TOKEN_BUDGET=60000

# National Vulnerability Database (NVD) API Key (optional but recommended for 50 req/30s ceiling vs 5 req/30s)
NVD_API_KEY=

# Local SQLite Database Path
DATABASE_URL=abuse-case.db

# Server Port
PORT=3000
